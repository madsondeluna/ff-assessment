; nvt.mdp (amber, family amber) - 100 ps NVT, heavy-atom position restraints
define                   = -DPOSRES
integrator               = md        ; leap-frog
dt                       = 0.002
nsteps                   = 50000
; Output
nstxout                  = 500
nstvout                  = 500
nstenergy                = 500
nstlog                   = 500
; Temperature coupling
tcoupl                   = V-rescale
tc-grps                  = Protein Non-Protein
tau-t                    = 0.1 0.1   ; ps
ref-t                    = 300 300
; Pressure coupling
pcoupl                   = no
; Velocities
continuation             = no
gen-vel                  = yes
gen-temp                 = 300
gen-seed                 = @SEED@    ; replaced per replica by 01_prepare.sh
pbc                      = xyz
; --- Constraints: AMBER (bonds to hydrogen, as SHAKE in Amber) ---------------
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-iter               = 1
lincs-order              = 4
; --- Nonbonded: AMBER recommended settings in GROMACS -------------------------
; AMBER protein force fields were parametrized with an 8-10 A real-space
; cutoff plus PME and an analytical long-range dispersion correction.
cutoff-scheme            = Verlet
nstlist                  = 10        ; adjusted automatically by mdrun
coulombtype              = PME
rcoulomb                 = 1.0       ; nm
vdwtype                  = Cut-off
vdw-modifier             = Potential-shift
rvdw                     = 1.0       ; nm
DispCorr                 = EnerPres  ; long-range dispersion correction
pme-order                = 4
fourierspacing           = 0.16      ; nm
